<root main_tree_to_execute="ShengsaiMission">
  <BehaviorTree ID="ShengsaiMission">
    <Sequence name="MissionSequence">
      <NavigateToGoal
        name="MoveToTarget"
        goal_x="{target_x}"
        goal_y="{target_y}"
        goal_yaw="{target_yaw_rad}"
        timeout_s="{navigation_timeout_s}"
        max_retries="{navigation_retries}"
        phase="GO_TO_TARGET"
        require_system_ready="true"
        system_ready_timeout_s="{system_ready_timeout_s}"
        offline_info_stale_s="{offline_info_stale_s}"
        arrival_xy_tolerance="0.20"
        arrival_yaw_tolerance="0.15"
        feedback_stale_s="2.0"
        arrival_dwell_s="0.5" />

      <EngageAtTarget
        name="EngageAtTarget"
        target_wait_timeout_s="{target_wait_timeout_s}"
        engage_timeout_s="{engage_timeout_s}"
        offline_info_stale_s="{offline_info_stale_s}" />

      <NavigateToGoal
        name="ReturnToStart"
        goal_x="{start_x}"
        goal_y="{start_y}"
        goal_yaw="{start_yaw_rad}"
        timeout_s="{navigation_timeout_s}"
        max_retries="{navigation_retries}"
        phase="RETURN_HOME"
        require_system_ready="false"
        arrival_xy_tolerance="0.20"
        arrival_yaw_tolerance="0.15"
        feedback_stale_s="2.0"
        arrival_dwell_s="0.5" />
    </Sequence>
  </BehaviorTree>
</root>
